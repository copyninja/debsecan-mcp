{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping one or more debsecan-exporter instances",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "description": "Whether the last vulnerability scan completed successfully.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "FAILED"
                },
                "1": {
                  "color": "green",
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "debsecan_scan_status{instance=~\"^$instance$\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Scan Status",
      "type": "stat"
    },
    {
      "description": "Time elapsed since the oldest scan across selected instances. Green = fresh, red = stale.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "orange",
                "value": 21600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "time() - min(debsecan_last_scan_timestamp_seconds{instance=~\"^$instance$\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Scan Age",
      "type": "stat"
    },
    {
      "description": "Total number of vulnerabilities currently affecting the system.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(debsecan_vulnerabilities_total{instance=~\"^$instance$\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total CVEs",
      "type": "stat"
    },
    {
      "description": "CVEs with critical or high severity — highest priority to address.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(debsecan_vulnerabilities_total{severity=~\"critical|high\", instance=~\"^$instance$\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Critical + High",
      "type": "stat"
    },
    {
      "description": "CVEs for which a Debian patch has already been released.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(debsecan_vulnerabilities_total{fix_available=\"true\", instance=~\"^$instance$\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Fix Available",
      "type": "stat"
    },
    {
      "description": "Number of distinct installed packages with at least one active vulnerability. One package may carry multiple CVEs — this tells you how many apt upgrade targets you have.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count(debsecan_package_info{instance=~\"^$instance$\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Affected Packages",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 7,
      "title": "Priority Intelligence",
      "type": "row"
    },
    {
      "description": "Top 10 CVEs by exploitation probability where a Debian patch already exists. Address these first.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "text": {},
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "topk(10,\n  debsecan_vulnerability_epss_score{instance=~\"^$instance$\"}\n  * on(cve, package, instance) group_left()\n    (debsecan_vulnerability_info{instance=~\"^$instance$\", fix_available=\"true\"})\n)",
          "instant": true,
          "legendFormat": "{{cve}} · {{package}}",
          "refId": "A"
        }
      ],
      "title": "🔴 Patch Now — High EPSS, Fix Available",
      "type": "bargauge"
    },
    {
      "description": "Top 10 CVEs by exploitation probability with no patch available. Monitor for Debian advisories.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue"
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.75
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "text": {},
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "topk(10,\n  debsecan_vulnerability_epss_score{instance=~\"^$instance$\"}\n  * on(cve, package, instance) group_left()\n    (debsecan_vulnerability_info{instance=~\"^$instance$\", fix_available=\"false\"})\n)",
          "instant": true,
          "legendFormat": "{{cve}} · {{package}}",
          "refId": "A"
        }
      ],
      "title": "🟡 Monitor — High EPSS, No Fix Yet",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 10,
      "title": "Full Vulnerability Inventory",
      "type": "row"
    },
    {
      "description": "All active CVEs enriched with EPSS score, fix version, installed package version, and remediation status. Filter by severity variable above.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "critical": {
                        "color": "dark-red",
                        "text": "Critical"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "high": {
                        "color": "orange",
                        "text": "High"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "medium": {
                        "color": "yellow",
                        "text": "Medium"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "low": {
                        "color": "blue",
                        "text": "Low"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "negligible": {
                        "color": "gray",
                        "text": "Negligible"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fix Available"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "true": {
                        "color": "green",
                        "text": "✓ Yes"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "false": {
                        "color": "red",
                        "text": "✗ No"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Remote"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "true": {
                        "color": "red",
                        "text": "Remote"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "false": {
                        "color": "blue",
                        "text": "Local"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "unknown": {
                        "color": "gray",
                        "text": "—"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "EPSS Score"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.displayMode",
                "value": "lcd-gauge"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue"
                    },
                    {
                      "color": "yellow",
                      "value": 0.1
                    },
                    {
                      "color": "orange",
                      "value": 0.3
                    },
                    {
                      "color": "red",
                      "value": 0.75
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View on NVD",
                    "url": "https://nvd.nist.gov/vuln/detail/${__value.text}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Instance"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 11,
      "options": {
        "footer": {
          "countRows": false,
          "enablePagination": true,
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "EPSS Score"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(\n  (\n    debsecan_vulnerability_epss_score{instance=~\"^$instance$\"}\n    * on(cve, package, instance) group_left(severity, urgency, fix_available, remote)\n      debsecan_vulnerability_info{instance=~\"^$instance$\"}\n  )\n  * on(package, instance) group_left(installed_version)\n    debsecan_package_info{instance=~\"^$instance$\"}\n)\n* on(cve, package, instance) group_left(fix_version)\n  debsecan_vulnerability_fix_info{instance=~\"^$instance$\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Vulnerability Details",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "urgency": true
            },
            "indexByName": {
              "Value": 8,
              "cve": 0,
              "fix_available": 3,
              "fix_version": 4,
              "installed_version": 5,
              "instance": 7,
              "package": 1,
              "remote": 6,
              "severity": 2
            },
            "renameByName": {
              "Value": "EPSS Score",
              "cve": "CVE",
              "fix_available": "Fix Available",
              "fix_version": "Fix Version",
              "installed_version": "Installed Version",
              "instance": "Instance",
              "package": "Package",
              "remote": "Remote",
              "severity": "Severity"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Debian suite codename and exporter version per monitored instance. Useful when monitoring mixed fleets (e.g. bookworm + trixie).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Instance"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suite"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exporter Version"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 0,
        "y": 28
      },
      "id": 13,
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "debsecan_exporter_info{instance=~\"^$instance$\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Instance Info",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true
            },
            "indexByName": {
              "instance": 0,
              "suite": 1,
              "version": 2
            },
            "renameByName": {
              "instance": "Instance",
              "suite": "Suite",
              "version": "Exporter Version"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 42,
  "tags": [
    "security",
    "debsecan",
    "debian"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(debsecan_exporter_info, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(debsecan_exporter_info, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
